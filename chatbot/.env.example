# Configuración del Proveedor LLM (Ollama / Gemini / Groq)
DEFAULT_PROVIDER=ollama
DEFAULT_MODEL=llama3
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Credenciales (NUNCA subir el archivo .env real al repositorio)[cite: 1]
GEMINI_API_KEY=tu_api_key_aqui
# Groq: gratis en https://console.groq.com (tier gratuito: ~30 req/min, ~1000 req/día)
GROQ_API_KEY=tu_api_key_aqui

# Rutas de red
OLLAMA_BASE_URL=http://localhost:11434

# Ollama GPU settings for local NVIDIA acceleration
# Keep the same model, but prefer GPU inference on RTX 4060.
OLLAMA_NO_CLOUD=1
OLLAMA_FLASH_ATTENTION=1
OLLAMA_IGPU_ENABLE=0
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_GPU_OVERHEAD=2000000000